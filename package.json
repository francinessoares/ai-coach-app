{
  "name": "ai-coach-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@ai-coach/mobile",
    "mobile:android": "npm run android --workspace=@ai-coach/mobile",
    "mobile:web": "npm run web --workspace=@ai-coach/mobile",
    "backend": "npm run dev --workspace=@ai-coach/backend",
    "backend:build": "npm run build --workspace=@ai-coach/backend"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.5.1"
  }
}
